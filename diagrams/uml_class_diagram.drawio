        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nabstract class Person {\n  - personId: String\n  - fullName: String\n  - phone: String\n  - email: String\n  + getContactDetails(): String\n  + updateProfile(): void\n}\n\nclass Patient {\n  - bloodGroup: String\n  - dateOfBirth: Date\n  + bookAppointment(): void\n  + viewHistory(): void\n}\n\nclass Doctor {\n  - doctorId: String\n  - specialization: String\n  - consultationFee: Double\n  + diagnosePatient(): void\n  + prescribeMedication(): void\n}\n\nclass Appointment {\n  - appointmentId: String\n  - appointmentDate: Date\n  - appointmentTime: String\n  - status: String\n  + schedule(): void\n  + cancel(): void\n  + complete(): void\n}\n\nclass MedicalRecord {\n  - recordId: String\n  - diagnosis: String\n  - prescription: String\n  - dateCreated: Date\n  + addEntry(): void\n  + viewRecord(): void\n}\n\nclass Bill {\n  - billId: String\n  - totalAmount: Double\n  - paymentDate: Date\n  - paymentStatus: String\n  + generateInvoice(): void\n  + processPayment(): void\n}\n\nPerson &lt;|-- Patient\nPerson &lt;|-- Doctor\n\nPatient \&quot;1\&quot; -- \&quot;0..*\&quot; Appointment : schedules &gt;\nDoctor \&quot;1\&quot; -- \&quot;0..*\&quot; Appointment : attends &gt;\nPatient \&quot;1\&quot; *-- \&quot;1..*\&quot; MedicalRecord : owns &gt;\nAppointment \&quot;1\&quot; -- \&quot;1\&quot; Bill : generates &gt;\n@enduml\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="T4ZOwupdQwmJR3Q3ZDI_-1">
